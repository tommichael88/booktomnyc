      "mat.MAT-MHR-DRY-PatchLarge",
      "mat.MAT-MHR-DOR-Weatherstrip"
    ],
    "assembly_classes": {
      "A0": {
        "minimum_tier": "routine",
        "meaning": "Simple: identical SKU within the authored per-item, total-duration and quantity limits; no wall anchoring, electrical work, cutting, two-person lift or site modification."
      },
      "A1": {
        "minimum_tier": "skilled",
        "meaning": "Standard flat-pack: mixed SKUs, a duration or quantity beyond the A0 limits, or one mild complication."
      },
      "A2": {
        "minimum_tier": "specialized",
        "meaning": "Complex: configurable or large assembly, wall anchoring, a required two-person lift, or work beyond the authored standard limits."
      },
      "A3": {
        "minimum_tier": "project",
        "meaning": "Custom or built-in: site measurement, cutting, electrical integration, structural involvement, a permit, or a multi-visit project."
      }
    },

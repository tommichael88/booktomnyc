{
  "note": "Authored input of migrate_legacy.js (T180), beside recovered_rules.json: the three independent axes every service declares (R-COMPLEX-AXES) and the vocabulary they are written in, which btnyc.json does not carry. The migration is a pure function of (btnyc.json, recovered_rules.json, this file). The skill tier is NOT here: it is read from btnyc.json (operational_metrics.complexity_tier), where it is already declared, so there is one authored value of it. validate_source.js checks everything in this file against the source alone (V-COMPLEX-*). Edit a value here, run migrate_legacy.js --write, then publish.js and report.js --write.",
  "axes_version": "1.0.0",
  "vocabulary": {
    "charter": {
      "rules": [
        "R-COMPLEX-AXES",
        "R-COMPLEX-COMPOUNDS",
        "R-COMPLEX-VOLUME",
        "P-COMPLEX-DYNAMIC",
        "P-COMPLEX-FURNITURE"
      ],
      "note": "The vocabulary of the three independent axes (skill tier, risk tier, batch-risk flag). Every term is the Charter's own; a hazard or basis a service cites must be named here, so the choice of each value can be reviewed against the meaning. A service's profile is the floor of its typical resolved shape: an answer, a tag or a branch promotes it as the job reveals itself (P-COMPLEX-DYNAMIC). The risk tier is the highest tier among the hazards a service names; the batch flag is true exactly when it names a ground. No axis is derived from another.",
      "decided_under": "G-GOVERN-AUTONOMY (T180): the values were derived from the Charter's definitions and each service's authored record, not asserted; PENDING_DECISIONS.md lists what an Operator may overrule."
    },
    "tiers": [
      "routine",
      "skilled",
      "specialized",
      "project"
    ],
    "risk_tiers": [
      "R0",
      "R1",
      "R2",
      "R3"
    ],
    "risk_hazards": {
      "none": {
        "tier": "R0",
        "meaning": "R0: no hazard, no shutoff, no permit, no regulation."
      },
      "minor_water": {
        "tier": "R1",
        "meaning": "R1: minor water. Work at a fixture downstream of its own working stop valve; a failure leaks at the fixture and is contained."
      },
      "minor_electrical": {
        "tier": "R1",
        "meaning": "R1: minor electrical. Work at a lamp socket or bulb, or on low-voltage control wiring; no fixed branch-circuit wiring is opened. Plugging a device into an outlet is not a hazard."
      },
      "ladder_under_16ft": {
        "tier": "R1",
        "meaning": "R1: ladder work with the working height under sixteen feet."
      },
      "weight_to_50lb": {
        "tier": "R1",
        "meaning": "R1: handles weights up to fifty pounds."
      },
      "dust_debris": {
        "tier": "R1",
        "meaning": "R1: dust and debris, but no structural involvement."
      },
      "active_water": {
        "tier": "R2",
        "meaning": "R2: active water. Replaces or alters a stop valve, a supply line or a sealed supply or drain connection; a failure leaks under line pressure or into the structure."
      },
      "active_electrical": {
        "tier": "R2",
        "meaning": "R2: active electrical. Opens or connects fixed branch-circuit wiring (an outlet, a switch, a fixture, a fan) or the inside of a mains-powered appliance."
      },
      "active_gas": {
        "tier": "R2",
        "meaning": "R2: active gas. Work on, or on the connection of, a gas appliance."
      },
      "structural": {
        "tier": "R2",
        "meaning": "R2: structural condition. The work meets, or may reveal, a condition in framing, subfloor, masonry or a crack that can signal movement."
      },
      "permit_or_code": {
        "tier": "R2",
        "meaning": "R2: a permit is required or a code applies to the work."
      },
      "height_over_16ft": {
        "tier": "R2",
        "meaning": "R2: working height over sixteen feet."
      },
      "weight_over_50lb": {
        "tier": "R2",
        "meaning": "R2: handles weights over fifty pounds."
      },
      "life_safety": {
        "tier": "R3",
        "meaning": "R3: life-safety work."
      },
      "regulated_trade": {
        "tier": "R3",
        "meaning": "R3: a regulated trade."
      },
      "structural_engineering": {
        "tier": "R3",
        "meaning": "R3: structural engineering."
      },
      "commercial_kitchen": {
        "tier": "R3",
        "meaning": "R3: commercial kitchen."
      },
      "hazmat": {
        "tier": "R3",
        "meaning": "R3: hazardous materials."
      }
    },
    "batch_physical_bases": {
      "drilled_hole": "A drilled hole: one bad hole among many is a door, a wall or a cabinet that needs replacing (R-COMPLEX-AXES).",
      "cut": "A cut: a mis-cut length or opening cannot be un-cut.",
      "sealed_joint": "A sealed joint whose seal is made once (a compression ferrule, a wax seal, a solvent weld): a bad one is redone by replacing the part.",
      "adhered_surface": "An adhered surface: an adhesive, a compound or a patch that cannot be lifted and reapplied.",
      "mis_sized_order": "A mis-sized order: the part is made to fit one opening and fits no other."
    },
    "batch_signals": {
      "overflow_formula": "The service's pricing formula declares an overflow rate (R-COMPLEX-COMPOUNDS: each unit past the included count is nearly a full job).",
      "per_unit_penalty_minutes": "The service's pricing formula declares penalty minutes (R-COMPLEX-COMPOUNDS: its author believed the N-th unit carries non-linear risk).",
      "single_use_consumable": "The service's required materials include a single-use consumable listed in single_use_consumable_material_ids (R-COMPLEX-COMPOUNDS: one mistake wastes a consumable that cannot be reused). Written as single_use_consumable:<material id>.",
      "scope_changing_branch": "An answer in the service's intake routes to another service (R-COMPLEX-COMPOUNDS: the batch has heterogeneous instances, and one of them can promote the whole job)."
    },
    "single_use_consumable_material_ids": [
      "mat.MAT-PLM-TLT-WaxRing",
      "mat.MAT-MHR-WIN-Caulk",
      "mat.MAT-MHR-FLR-Grout",
